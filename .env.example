# =====================================================================
# GreenMate 番茄大棚环境监测系统 — 环境变量模板
# 复制为 .env 使用(或直接在终端 export);全部变量均为可选,
# 不填时系统按诚实降级运行(结构化判断不受影响,详见每项说明)。
# 复制命令:cp .env.example .env
# =====================================================================

# ---------- LLM 密钥(二选一即可;都不填 = 全系统 LLM 功能降级) ----------
# LLM 主密钥:用于 B01 问答 / B04 引用回答 / B05 工具智能体 / B07 综合解释。
# 不填会怎样:所有 LLM 路径如实报 no_api_key 并标记【证据缺失】,
# 结构化判断、天气、检索、预测等非 LLM 功能全部正常。
DEEPSEEK_API_KEY=

# Claude Code 自带令牌,作为 LLM 密钥回退源。
# 注意:在本机 Claude Code 环境中直接复用该令牌调用 DeepSeek 会被权限
# 分类器拦截;课程演示建议显式设置 DEEPSEEK_API_KEY。
ANTHROPIC_AUTH_TOKEN=

# ---------- 各模块 LLM 端点(默认 DeepSeek OpenAI 兼容接口) ----------
# 不填会怎样:使用默认值 https://api.deepseek.com/chat/completions 与
# deepseek-chat 模型;自行换兼容端点时按模块分别覆盖。
B01_LLM_BASE_URL=https://api.deepseek.com/chat/completions
B01_LLM_MODEL=deepseek-chat
B01_LLM_TIMEOUT=30
B04_LLM_BASE_URL=https://api.deepseek.com/chat/completions
B04_LLM_MODEL=deepseek-chat
B04_LLM_TIMEOUT=30
B05_LLM_BASE_URL=https://api.deepseek.com/chat/completions
B05_LLM_MODEL=deepseek-chat
B05_LLM_TIMEOUT=30
B05_MAX_STEPS=6
B07_LLM_BASE_URL=https://api.deepseek.com/chat/completions
B07_LLM_MODEL=deepseek-chat
B07_LLM_TIMEOUT=30

# ---------- B03 天气证据 ----------
# 默认地点(城市名 北京/上海/广州 或 "lat,lng");不填时 get_weather_forecast
# 需显式传 location 参数,否则按默认 北京 处理。
B03_LOCATION=北京
# Open-Meteo 主接口(免 Key)。不填会怎样:使用默认官方地址;断网时天气
# 证据如实报 network_timeout 并降级为【证据缺失】,绝不伪造成功。
B03_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# QWeather 备用接口,仅用于鉴权失败测试(failtest 用例)。
# 不填会怎样:qweather provider 调用如实报 api_key_error——这正是 B03
# 失败验证的预期用例,不影响 Open-Meteo 主路径。
B03_QWEATHER_API_KEY=
B03_QWEATHER_BASE_URL=https://devapi.qweather.com/v7/weather/3d
# 天气请求超时(秒)。不填默认 10。
B03_WEATHER_TIMEOUT=10

# ---------- Web 服务端口(全部只绑 127.0.0.1 本机回环) ----------
# 不填会怎样:使用默认端口;被占用时服务打印提示并返回(py b09_portal.py serve
# 会自动探测,已在运行的端口跳过启动)。
B01_WEB_PORT=8123
B02_WEB_PORT=8223
B09_WEB_PORT=8300

# ---------- B04 知识检索 ----------
# Top-K 检索相似度阈值。不填默认 0.17(资料不足时输出【资料不足/无法确认】)。
B04_SCORE_THRESHOLD=0.17
